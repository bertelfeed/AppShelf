<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest of the Microsoft Store version. build.ps1 -Msix fills the $...$ values: the identity comes from
  Partner Center (Product management → Product identity), the version from Directory.Build.props.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>AppShelf</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ru-ru" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="AppShelf.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="AppShelf" Description="Folders of apps on the desktop and taskbar"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Folder shortcuts start the app through this alias: its path survives updates, the package folder does not.
             MCP clients start the server through it too, with the mcp switch (see MCP.md). The Store rejects applications hidden from Start
             (AppListEntry="none"), and an application has only one alias, so the server has no alias of its own. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="AppShelf.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="appshelf.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <!-- Off until the user turns it on in Settings; TaskId must match PackageStartup.TaskId. -->
        <desktop:Extension Category="windows.startupTask" Executable="AppShelf.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="AppShelfStartup" Enabled="false" DisplayName="AppShelf" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
